-- Single-row table holding the local user's identity (encrypted at rest
-- because the whole database file is opened via SQLCipher with a
-- device-derived passphrase — see DatabaseDriverFactory).
CREATE TABLE IdentityRow (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 0 CHECK (id = 0), -- singleton row
    publicKey BLOB NOT NULL,
    privateKey BLOB NOT NULL,
    peerId TEXT NOT NULL,
    displayName TEXT NOT NULL DEFAULT '',
    createdAtEpochMs INTEGER NOT NULL
);

insertIdentity:
INSERT OR REPLACE INTO IdentityRow(id, publicKey, privateKey, peerId, displayName, createdAtEpochMs)
VALUES (0, ?, ?, ?, ?, ?);

selectIdentity:
SELECT * FROM IdentityRow WHERE id = 0;

updateDisplayName:
UPDATE IdentityRow SET displayName = ? WHERE id = 0;

-- Servers (communities) the local user has created or joined.
CREATE TABLE Server (
    id TEXT PRIMARY KEY NOT NULL,       -- content-addressed / random UUID
    name TEXT NOT NULL,
    iconUri TEXT,
    description TEXT NOT NULL DEFAULT '',
    ownerPeerId TEXT NOT NULL,
    createdAtEpochMs INTEGER NOT NULL
);

insertServer:
INSERT INTO Server(id, name, iconUri, description, ownerPeerId, createdAtEpochMs)
VALUES (?, ?, ?, ?, ?, ?);

selectAllServers:
SELECT * FROM Server ORDER BY createdAtEpochMs ASC;

deleteServer:
DELETE FROM Server WHERE id = ?;

-- Channels belonging to a server.
CREATE TABLE Channel (
    id TEXT PRIMARY KEY NOT NULL,
    serverId TEXT NOT NULL REFERENCES Server(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    position INTEGER NOT NULL DEFAULT 0
);

insertChannel:
INSERT INTO Channel(id, serverId, name, position)
VALUES (?, ?, ?, ?);

selectChannelsForServer:
SELECT * FROM Channel WHERE serverId = ? ORDER BY position ASC;

-- Known peers (contacts) — their identity + last known network location.
-- x25519PublicKey/SecretKey are OUR ratchet keypair generated for talking to
-- this peer, not theirs; ratchetRootKey/sendChainKey/recvChainKey persist an
-- ACTIVE session so it survives an app restart (see DoubleRatchetSession docs
-- for what is intentionally still NOT persisted — skipped message keys).
CREATE TABLE Peer (
    peerId TEXT PRIMARY KEY NOT NULL,
    displayName TEXT NOT NULL DEFAULT '',
    ed25519PublicKey BLOB NOT NULL,
    lastKnownHost TEXT,
    lastKnownPort INTEGER,
    ratchetRootKey BLOB,
    ratchetSelfSecretKey BLOB,
    ratchetSelfPublicKey BLOB,
    ratchetRemotePublicKey BLOB,
    ratchetSendChainKey BLOB,
    ratchetRecvChainKey BLOB,
    ratchetSendMessageNumber INTEGER NOT NULL DEFAULT 0,
    ratchetRecvMessageNumber INTEGER NOT NULL DEFAULT 0
);

insertOrUpdatePeer:
INSERT OR REPLACE INTO Peer(
    peerId, displayName, ed25519PublicKey, lastKnownHost, lastKnownPort,
    ratchetRootKey, ratchetSelfSecretKey, ratchetSelfPublicKey, ratchetRemotePublicKey,
    ratchetSendChainKey, ratchetRecvChainKey, ratchetSendMessageNumber, ratchetRecvMessageNumber
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPeer:
SELECT * FROM Peer WHERE peerId = ?;

selectAllPeers:
SELECT * FROM Peer ORDER BY displayName ASC;

updatePeerNetworkLocation:
UPDATE Peer SET lastKnownHost = ?, lastKnownPort = ? WHERE peerId = ?;

-- Direct messages between the local user and one peer (Phase 2 scope: DMs only).
CREATE TABLE Message (
    id TEXT PRIMARY KEY NOT NULL,
    peerId TEXT NOT NULL REFERENCES Peer(peerId) ON DELETE CASCADE,
    body TEXT NOT NULL,
    outgoing INTEGER NOT NULL, -- 1 = sent by us, 0 = received
    sentAtEpochMs INTEGER NOT NULL,
    deliveryState TEXT NOT NULL DEFAULT 'sent' -- sent | delivered | failed | received
);

insertMessage:
INSERT INTO Message(id, peerId, body, outgoing, sentAtEpochMs, deliveryState)
VALUES (?, ?, ?, ?, ?, ?);

selectMessagesForPeer:
SELECT * FROM Message WHERE peerId = ? ORDER BY sentAtEpochMs ASC;

updateMessageDeliveryState:
UPDATE Message SET deliveryState = ? WHERE id = ?;
